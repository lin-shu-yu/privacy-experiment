  Serial.print(":");
  Serial.println(currentTime.getSeconds());
}

//set up stuff
void setup() {
  Serial.begin(115200);
  while (!Serial);

  //WiFi
  Serial.print("Connecting to Wi-Fi...");
  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED){
    delay(500);
    Serial.print(".");
  }
  Serial.println("Connected!");

  //time set up
  RTC.begin();
  timeClient.begin();
  if(timeClient.update()){
    unsigned long epochTime= timeClient.getEpochTime();
    RTCTime localTime(epochTime);
    RTC.setTime(localTime);
    Serial.println("RTC synchronized teehee");
  }else{
    Serial.println("NTP update failed grrr");
  }
  WiFi.disconnect();

 //pin stuff
  pinMode(2, INPUT_PULLUP);
  pinMode(3, INPUT_PULLUP);
  pinMode(4, INPUT_PULLUP);
  pinMode(9, OUTPUT);
}

//loopdy loop
void loop() {
  int bgreen = digitalRead(2);
  int bgrey = digitalRead(3);
  int byellow = digitalRead(4);
  delay(250);


 //button logic
  if (bgreen == LOW) { 
    digitalWrite(9, HIGH);
    record("green");
  } else if (bgrey == LOW) {
    digitalWrite(9, LOW);
    record("grey");
  } else if (byellow == LOW) {
    digitalWrite(9,HIGH);
    record("yellow");
    delay(1000);
    digitalWrite(9,LOW);
  }
}
