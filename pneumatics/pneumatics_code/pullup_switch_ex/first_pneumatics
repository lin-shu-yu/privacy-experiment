//variables (this actually aren't used)
int hours;
String pressed = "none";

//network connection information
const char* ssid     = "iPhone (54)";
const char* password = "Mercury2007!!";

//file and microchip stuff
const int chipSelect = 6;
File bFile;

//more network stuff
WiFiUDP ntpUDP;
//changes with timechange (-5 during standard time and -4 during dls)
NTPClient timeClient(ntpUDP, "pool.ntp.org", -4*3600);

//function for time I hope this works =<
void record(String bcolor){
  if (!SD.begin(chipSelect, SPI_QUARTER_SPEED)) {
    Serial.println("SD re-init failed");
    return;
  }
  RTCTime currentTime;
  RTC.getTime(currentTime);
  bFile = SD.open("btnlog.txt", FILE_WRITE);
  if (bFile) {
    bFile.print(bcolor);
    bFile.print(" pressed: ");
    bFile.print(Month2int(currentTime.getMonth()));
    bFile.print("-");
    bFile.print(currentTime.getDayOfMonth());
    bFile.print("-");
    bFile.print(currentTime.getYear());
    bFile.print(" ");
    bFile.print(currentTime.getHour());
    bFile.print(":");
    bFile.print(currentTime.getMinutes());
    bFile.print(":");
    bFile.println(currentTime.getSeconds());
    bFile.close();
  } else {
    Serial.println("Writing to memory card no work");
  }
}

//set up stuff
void setup() {
  Serial.begin(115200);
  while (!Serial);

  //WiFi
  Serial.print("Connecting to Wi-Fi...");
  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED){
    delay(500);
    Serial.print(".");
  }
  Serial.println("Connected!");

  //time set up
  RTC.begin();
  timeClient.begin();
  if(timeClient.update()){
    unsigned long epochTime= timeClient.getEpochTime();
    RTCTime localTime(epochTime);
    RTC.setTime(localTime);
    Serial.println("RTC synchronized teehee");
  }else{
    Serial.println("NTP update failed grrr");
  }
  WiFi.disconnect();

 //memory card stuff
 Serial.println("Setting up memory card!");
 if (!SD.begin(chipSelect, SPI_QUARTER_SPEED)){
  Serial.println("Memory card set up failed :(");
  while (1); //haults code
  }
 Serial.println("Memory card succesfully set up!");

 //pin stuff
  pinMode(3, INPUT_PULLUP);
  pinMode(4, INPUT_PULLUP);
  pinMode(5, INPUT_PULLUP);
  pinMode(7, OUTPUT);
}

//loopdy loop
void loop() {
  int bgreen = digitalRead(3);
  int bgrey = digitalRead(4);
  int byellow = digitalRead(5);
  delay(250);


 //button logic
  if (bgreen == LOW) { 
    record("green");
    digitalWrite(7, HIGH);
  } else if (bgrey == LOW) {
    record("grey");
    digitalWrite(7, LOW);
  } else if (byellow == LOW) {
    record("grey");
    digitalWrite(7,HIGH);
    delay(1000);
    digitalWrite(7,LOW);
  }
}
