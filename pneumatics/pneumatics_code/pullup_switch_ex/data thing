def cln(df,name):
    clean_df=df.iloc[17:37, 0:2]
    clean_df=clean_df.drop('baseline ',axis=1)
    clean_df=clean_df.drop([23,30])
    clean_df.reset_index(drop=True, inplace=True)
    new_labels = {old: new for old, new in zip(range(0,21), range(1, 19))}
    clean_df=clean_df.rename(index=new_labels)
    clean_df=clean_df.rename(columns={'passive': name})
    clean_df=clean_df.rename(columns={'active': name})
    return clean_df

